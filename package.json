{
  "name": "gtvzone-monorepo",
  "private": true,
  "description": "Spatial navigation for Smart TV apps: framework-agnostic core with DOM, React and Angular bindings",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
