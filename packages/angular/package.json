  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "keywords": ["angular", "angular-signals", "angular-directives", "smart-tv", "tv", "tv-app", "spatial-navigation", "focus-management", "d-pad", "remote-control", "keyboard-navigation", "arrow-keys", "10-foot-ui", "tizen", "samsung-tv", "webos", "lg-webos", "vidaa", "hisense", "hbbtv", "android-tv", "google-tv", "vizio", "smartcast", "fire-tv", "huawei", "aoc", "movistar", "living-apps", "webview", "typescript"],
  "repository": { "type": "git", "url": "git+https://github.com/renearias/gtvzone.git", "directory": "packages/angular" },
  "homepage": "https://github.com/renearias/gtvzone#readme",
  "bugs": "https://github.com/renearias/gtvzone/issues",
  "publishConfig": { "access": "public", "directory": "dist" },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@arxis/gtvzone-core": "workspace:^",
    "@arxis/gtvzone-dom": "workspace:^",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/core": ">=16.1.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "ng-packagr": "~22.1.0",
    "rxjs": "^7.8.0"
  }
}
