{
  "name": "@arxis/gtvzone-angular",
  "version": "1.0.0",
  "description": "Angular spatial navigation for Smart TV apps (Samsung Tizen, LG webOS, Hisense VIDAA, HbbTV, Android TV and more): standalone directives and a signals service for D-pad and remote-control focus",
