{
  "name": "@arxis/gtvzone-dom",
  "version": "1.0.0-alpha.0",
  "description": "Adapter de navegador para gtvzone: medición, teclas por plataforma y modo selectores para apps sin framework",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "keywords": ["smart-tv", "tizen", "webos", "hbbtv", "spatial-navigation", "focus"],
  "repository": { "type": "git", "url": "git+https://github.com/renearias/gtvzone.git", "directory": "packages/dom" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@arxis/gtvzone-core": "workspace:^"
  }
}
