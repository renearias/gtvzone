{
  "name": "@arxis/gtvzone-react",
  "version": "1.0.0-alpha.0",
  "description": "React spatial navigation for Smart TV apps (Samsung Tizen, LG webOS, Hisense VIDAA, HbbTV, Android TV and more): useFocusable hook, FocusZone and FocusLayer for D-pad and remote-control focus",
  "author": "Rene Arias (https://github.com/renearias)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "keywords": ["react", "react-hooks", "react-tv", "smart-tv", "tv", "tv-app", "spatial-navigation", "focus-management", "d-pad", "remote-control", "keyboard-navigation", "arrow-keys", "10-foot-ui", "tizen", "samsung-tv", "webos", "lg-webos", "vidaa", "hisense", "hbbtv", "android-tv", "google-tv", "vizio", "smartcast", "fire-tv", "huawei", "aoc", "movistar", "living-apps", "webview", "typescript"],
  "repository": { "type": "git", "url": "git+https://github.com/renearias/gtvzone.git", "directory": "packages/react" },
  "homepage": "https://github.com/renearias/gtvzone#readme",
  "bugs": "https://github.com/renearias/gtvzone/issues",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@arxis/gtvzone-core": "workspace:^",
    "use-sync-external-store": "^1.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@arxis/gtvzone-dom": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/use-sync-external-store": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
