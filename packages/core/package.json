{
  "name": "@arxis/gtvzone-core",
  "version": "1.0.0-alpha.0",
  "description": "Framework-agnostic spatial navigation engine for Smart TV apps (Samsung Tizen, LG webOS, Hisense VIDAA, HbbTV, Android TV and more): focus management for D-pad and remote-control input, zero dependencies",
  "author": "Rene Arias (https://github.com/renearias)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "keywords": ["smart-tv", "tv", "tv-app", "spatial-navigation", "focus-management", "d-pad", "remote-control", "keyboard-navigation", "arrow-keys", "10-foot-ui", "tizen", "samsung-tv", "webos", "lg-webos", "vidaa", "hisense", "hbbtv", "android-tv", "google-tv", "vizio", "smartcast", "fire-tv", "huawei", "aoc", "movistar", "living-apps", "webview", "framework-agnostic", "zero-dependencies", "typescript"],
  "repository": { "type": "git", "url": "git+https://github.com/renearias/gtvzone.git", "directory": "packages/core" },
  "homepage": "https://github.com/renearias/gtvzone#readme",
  "bugs": "https://github.com/renearias/gtvzone/issues",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
