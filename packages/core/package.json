{
  "name": "@arxis/gtvzone-core",
  "version": "1.0.0-alpha.0",
  "description": "Motor de navegación espacial para Smart TV, sin DOM ni framework",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "keywords": ["smart-tv", "tizen", "webos", "spatial-navigation", "focus", "remote-control"],
  "repository": { "type": "git", "url": "git+https://github.com/renearias/gtvzone.git", "directory": "packages/core" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
